{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$VAULT/.claude/scripts/session_status.sh\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$VAULT/.claude/scripts/prompt_recall.py\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$VAULT/.claude/scripts/session_capture.py\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
